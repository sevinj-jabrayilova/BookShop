@model SliderEditVM
<div class="container">
    <div class="image">
        <img src="~/client/assets/images/@Model.ExistImage" style="width:300px; height:200px" />
    </div>
    <form method="post" asp-action="Edit" enctype="multipart/form-data">

        <div class="mb-3">
            <label class="form-label">Title: </label>
            <input asp-for="Title" class="form-control">
            <span class="text-danger" asp-validation-for="Title"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Description: </label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span class="text-danger" asp-validation-for="Description"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Image: </label>
            <input asp-for="NewImage" class="form-control" accept="image/png, image/gif, image/jpeg">
            <span class="text-danger" asp-validation-for="NewImage"></span>
        </div>

        <button type="submit" class="btn btn-primary">Submit</button>
        <a class="btn btn-primary" asp-action="Index">Cancel</a>

    </form>


</div>

