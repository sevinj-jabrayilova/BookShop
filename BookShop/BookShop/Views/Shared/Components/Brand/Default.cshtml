
@model IEnumerable<BrandUIVM>
<section id="client-holder" data-aos="fade-up">
	<div class="container">
		<div class="row">
			<div class="inner-content">
				<div class="logo-wrap">
					<div class="grid">
						@foreach (var item in Model)
						{
							<a href="#"><img src="~/client/assets/images/@item.Image" alt="client"></a>
						}
					</div>
				</div><!--image-holder-->
			</div>
		</div>
	</div>
</section>